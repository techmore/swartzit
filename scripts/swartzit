#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$0"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_LINK_DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd)
  SCRIPT_LINK=$(readlink "$SCRIPT_PATH")
  if [[ "$SCRIPT_LINK" == /* ]]; then
    SCRIPT_PATH="$SCRIPT_LINK"
  else
    SCRIPT_PATH="$SCRIPT_LINK_DIR/$SCRIPT_LINK"
  fi
done
SCRIPT_DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd)
HOME_DIR="${SWARTZIT_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
SERVER="${SWARTZIT_SERVER:-$HOME_DIR/target/release/swartzit-server}"
WEB_BUILD="${SWARTZIT_WEB_BUILD:-$HOME_DIR/apps/web/build}"
if [[ ! -x "$SERVER" && -x "$SCRIPT_DIR/swartzit-server" ]]; then SERVER="$SCRIPT_DIR/swartzit-server"; fi
if [[ ! -d "$WEB_BUILD" && -d "$HOME_DIR/libexec/build" ]]; then WEB_BUILD="$HOME_DIR/libexec/build"; fi
if [[ -n "${SWARTZIT_STATE_DIR:-}" ]]; then
  STATE_DIR="$SWARTZIT_STATE_DIR"
elif [[ -d "$HOME_DIR/.git" || -d "$HOME_DIR/.local" ]]; then
  STATE_DIR="$HOME_DIR/.local"
else
  STATE_DIR="${SWARTZIT_DATA_DIR:-$HOME/Library/Application Support/Swartzit}"
fi
mkdir -p "$STATE_DIR"
SCRIPT_HOME="$HOME_DIR/scripts"
[[ -d "$SCRIPT_HOME" ]] || SCRIPT_HOME="$HOME_DIR/libexec"

MACOS_LAUNCHD_DOMAIN="gui/$(id -u)"
MACOS_API_LAUNCHD_LABEL="${SWARTZIT_API_LAUNCHD_LABEL:-org.stoverparc.swartzit-homebrew-api}"
MACOS_WEB_LAUNCHD_LABEL="${SWARTZIT_WEB_LAUNCHD_LABEL:-org.stoverparc.swartzit-homebrew-web}"

macos_launchd_available() {
  [[ "$(uname -s)" == Darwin && -x /bin/launchctl ]]
}

macos_agent_target() {
  echo "$MACOS_LAUNCHD_DOMAIN/$1"
}

macos_agent_plist() {
  echo "$HOME/Library/LaunchAgents/$1.plist"
}

macos_agent_loaded() {
  macos_launchd_available || return 1
  launchctl print "$(macos_agent_target "$1")" >/dev/null 2>&1
}

macos_agent_configured() {
  macos_launchd_available || return 1
  macos_agent_loaded "$1" || [[ -f "$(macos_agent_plist "$1")" ]]
}

start_macos_agent() {
  local label="$1"
  local target
  target="$(macos_agent_target "$label")"
  if macos_agent_loaded "$label"; then
    launchctl kickstart -k "$target"
  elif [[ -f "$(macos_agent_plist "$label")" ]]; then
    launchctl bootstrap "$MACOS_LAUNCHD_DOMAIN" "$(macos_agent_plist "$label")"
  else
    return 1
  fi
}

stop_macos_agent() {
  local label="$1"
  macos_agent_loaded "$label" || return 0
  launchctl bootout "$(macos_agent_target "$label")"
}

stop_direct_process() {
  local name="$1"
  local pid command
  [[ -f "$STATE_DIR/$name.pid" ]] || return 0
  pid="$(cat "$STATE_DIR/$name.pid")"
  command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  if [[ "$name" == api && ( "$command" == *swartzit-server* || "$command" == *"$SERVER"* ) ]]; then
    kill "$pid" 2>/dev/null || true
  elif [[ "$name" == web && "$command" == *"$WEB_BUILD"* ]]; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$STATE_DIR/$name.pid"
}

start_service_processes() {
  if macos_agent_configured "$MACOS_API_LAUNCHD_LABEL"; then
    stop_direct_process api
    start_macos_agent "$MACOS_API_LAUNCHD_LABEL" || {
      echo "Could not start macOS API LaunchAgent: $MACOS_API_LAUNCHD_LABEL" >&2
      return 1
    }
  else
    nohup "$SERVER" >"$STATE_DIR/api.log" 2>&1 < /dev/null & echo $! > "$STATE_DIR/api.pid"
  fi

  if macos_agent_configured "$MACOS_WEB_LAUNCHD_LABEL"; then
    stop_direct_process web
    start_macos_agent "$MACOS_WEB_LAUNCHD_LABEL" || {
      echo "Could not start macOS web LaunchAgent: $MACOS_WEB_LAUNCHD_LABEL" >&2
      return 1
    }
  else
    nohup node "$WEB_BUILD" >"$STATE_DIR/web.log" 2>&1 < /dev/null & echo $! > "$STATE_DIR/web.pid"
  fi
}

stop_service_processes() {
  stop_direct_process api
  stop_direct_process web
  stop_macos_agent "$MACOS_API_LAUNCHD_LABEL" || true
  stop_macos_agent "$MACOS_WEB_LAUNCHD_LABEL" || true
}

interface_ip() {
  local interface="$1"
  if [[ "$interface" == "loopback" || "$interface" == "localhost" || "$interface" == "lo0" ]]; then
    echo 127.0.0.1
    return 0
  fi
  ipconfig getifaddr "$interface" 2>/dev/null || \
    ifconfig "$interface" 2>/dev/null | awk '$1 == "inet" { print $2; exit }'
}

resolve_network() {
  NETWORK_MODE="$1"
  case "$NETWORK_MODE" in
    local|localhost|loopback|lo0)
      NETWORK_MODE=loopback
      NETWORK_LABEL="Loopback"
      WEB_INTERFACE=lo0
      WEB_BIND_IP=127.0.0.1
      ;;
    lan|wifi)
      NETWORK_MODE=wifi
      NETWORK_LABEL="Wi-Fi/LAN"
      WEB_INTERFACE="${SWARTZIT_WIFI_INTERFACE:-en0}"
      WEB_BIND_IP="$(interface_ip "$WEB_INTERFACE" || true)"
      if [[ -z "$WEB_BIND_IP" && "$WEB_INTERFACE" == "en0" ]]; then
        WEB_INTERFACE=en1
        WEB_BIND_IP="$(interface_ip "$WEB_INTERFACE" || true)"
      fi
      ;;
    ethernet|eth)
      NETWORK_MODE=ethernet
      NETWORK_LABEL="Ethernet"
      WEB_INTERFACE="${SWARTZIT_ETHERNET_INTERFACE:-en1}"
      WEB_BIND_IP="$(interface_ip "$WEB_INTERFACE" || true)"
      ;;
    vpn)
      NETWORK_MODE=vpn
      NETWORK_LABEL="VPN"
      WEB_INTERFACE=utun
      WEB_BIND_IP=""
      if command -v tailscale >/dev/null 2>&1; then
        WEB_BIND_IP="$(tailscale ip -4 2>/dev/null | head -1 || true)"
        [[ -n "$WEB_BIND_IP" ]] && WEB_INTERFACE=tailscale
      fi
      if [[ -z "$WEB_BIND_IP" ]]; then
        WEB_BIND_IP="$(ifconfig 2>/dev/null | awk '/^utun[0-9]+:/{iface=$1; sub(":","",iface)} iface && /inet /{print $2; exit}' || true)"
      fi
      ;;
    public)
      NETWORK_MODE=public
      NETWORK_LABEL="Public via Caddy"
      WEB_INTERFACE=loopback
      WEB_BIND_IP=127.0.0.1
      ;;
    en[0-9]*|utun[0-9]*|bridge[0-9]*)
      NETWORK_MODE=interface
      NETWORK_LABEL="Interface $1"
      WEB_INTERFACE="$1"
      WEB_BIND_IP="$(interface_ip "$WEB_INTERFACE" || true)"
      ;;
    *)
      echo "Usage: swartzit start [wifi|loopback|ethernet|vpn|public|en0|en1]" >&2
      return 2
      ;;
  esac
  [[ -n "$WEB_BIND_IP" ]] || { echo "Could not find an IPv4 address for $NETWORK_LABEL." >&2; return 1; }
}

resolve_api_interface() {
  API_REQUESTED_INTERFACE="${SWARTZIT_API_INTERFACE:-loopback}"
  case "$API_REQUESTED_INTERFACE" in
    local|localhost|loopback|lo0)
      API_INTERFACE=loopback
      API_BIND_IP=127.0.0.1
      ;;
    wifi|lan)
      API_INTERFACE="$WEB_INTERFACE"
      API_BIND_IP="$WEB_BIND_IP"
      ;;
    ethernet|eth)
      API_INTERFACE="${SWARTZIT_ETHERNET_INTERFACE:-en1}"
      API_BIND_IP="$(interface_ip "$API_INTERFACE" || true)"
      ;;
    *)
      API_INTERFACE="$API_REQUESTED_INTERFACE"
      API_BIND_IP="$(interface_ip "$API_INTERFACE" || true)"
      ;;
  esac
  [[ -n "$API_BIND_IP" ]] || { echo "Could not find an IPv4 address for API interface $API_REQUESTED_INTERFACE." >&2; return 1; }
}

caddy_configured() {
  [[ "${SWARTZIT_CADDY:-0}" == 1 ]] && return 0
  if [[ "$(uname -s)" == Darwin && -f "$HOME/Library/LaunchAgents/org.stoverparc.swartzit-caddy.plist" ]]; then
    return 0
  fi
  [[ -f "$STATE_DIR/caddy-runtime.Caddyfile" ]]
}

refresh_caddy() {
  caddy_configured || return 0

  local caddy_script="$SCRIPT_HOME/swartzit-caddy.sh"
  if [[ ! -x "$caddy_script" ]]; then
    echo "Caddy is configured, but its launcher is missing: $caddy_script" >&2
    return 1
  fi

  # Homebrew upgrades replace versioned kegs. If a previously installed
  # LaunchAgent still points at the removed keg, refresh would kickstart a
  # dead path and make the whole restart look unhealthy. Reinstall the agent
  # against this release before attempting the refresh.
  if macos_launchd_available; then
    local caddy_plist="$HOME/Library/LaunchAgents/org.stoverparc.swartzit-caddy.plist"
    if [[ -f "$caddy_plist" && -x /usr/libexec/PlistBuddy ]]; then
      local configured_caddy_script
      configured_caddy_script=$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:1' "$caddy_plist" 2>/dev/null || true)
      if [[ "$configured_caddy_script" != "$caddy_script" ]]; then
        if ! SWARTZIT_STATE_DIR="$STATE_DIR" "$SCRIPT_HOME/install-mac-caddy.sh"; then
          echo "Caddy LaunchAgent could not be refreshed for this release." >&2
          return 1
        fi
        return 0
      fi
    fi
  fi

  export SWARTZIT_CADDY=1
  if ! SWARTZIT_STATE_DIR="$STATE_DIR" "$caddy_script" refresh; then
    echo "Caddy failed to refresh for $WEB_BIND_IP:$PORT." >&2
    return 1
  fi
}

case "${1:-status}" in
  version)
    VERSION_FILE="${SWARTZIT_VERSION_FILE:-$SCRIPT_DIR/VERSION}"
    [[ -f "$VERSION_FILE" ]] || VERSION_FILE="$HOME_DIR/VERSION"
    [[ -f "$VERSION_FILE" ]] || VERSION_FILE="$HOME_DIR/libexec/VERSION"
    [[ -f "$VERSION_FILE" ]] || VERSION_FILE="$HOME_DIR/../VERSION"
    if [[ -f "$VERSION_FILE" ]]; then cat "$VERSION_FILE"; else echo "development"; fi
    ;;
  start)
    shift
    NETWORK_REQUESTED="${1:-${SWARTZIT_MODE:-${SWARTZIT_BIND_INTERFACE:-wifi}}}"
    resolve_network "$NETWORK_REQUESTED"
    resolve_api_interface
    if caddy_configured; then
      export SWARTZIT_CADDY=1
    fi
    : "${DATABASE_URL:=postgres://swartzit:swartzit-local-only@127.0.0.1:54329/swartzit}"
    : "${API_PORT:=18080}"
    : "${BIND_ADDR:=$API_BIND_IP:$API_PORT}"
    : "${API_URL:=http://$API_BIND_IP:$API_PORT}"
    : "${HOST:=$WEB_BIND_IP}"
    : "${PORT:=4173}"
    REQUESTED_ORIGIN="${SWARTZIT_ORIGIN:-${ORIGIN:-}}"
    : "${ORIGIN:=${SWARTZIT_ORIGIN:-http://$WEB_BIND_IP:$PORT}}"
    export DATABASE_URL BIND_ADDR API_URL HOST PORT ORIGIN SWARTZIT_STATE_DIR="$STATE_DIR"
    {
      printf 'API_URL=%q\n' "$API_URL"
      printf 'API_PORT=%q\n' "$API_PORT"
      printf 'PORT=%q\n' "$PORT"
      printf 'SWARTZIT_ORIGIN=%q\n' "$REQUESTED_ORIGIN"
      printf 'SWARTZIT_LOCAL_URL=%q\n' "http://$HOST:$PORT"
      printf 'SWARTZIT_NETWORK_MODE=%q\n' "$NETWORK_MODE"
      printf 'SWARTZIT_NETWORK_LABEL=%q\n' "$NETWORK_LABEL"
      printf 'SWARTZIT_WEB_INTERFACE=%q\n' "$WEB_INTERFACE"
      printf 'SWARTZIT_WEB_BIND_IP=%q\n' "$WEB_BIND_IP"
      printf 'SWARTZIT_API_BIND_INTERFACE=%q\n' "$API_INTERFACE"
      printf 'SWARTZIT_API_BIND_IP=%q\n' "$API_BIND_IP"
      printf 'SWARTZIT_STARTED_AT=%q\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      printf 'SWARTZIT_CHECK_URL=%q\n' "${SWARTZIT_CHECK_URL:-}"
      printf 'SWARTZIT_CADDY=%q\n' "${SWARTZIT_CADDY:-0}"
      printf 'SWARTZIT_DOMAIN=%q\n' "${SWARTZIT_DOMAIN:-}"
      printf 'SWARTZIT_CADDY_BIND_IP=%q\n' "${SWARTZIT_CADDY_BIND_IP:-0.0.0.0}"
      printf 'SWARTZIT_CADDY_UPSTREAM=%q\n' "${SWARTZIT_CADDY_UPSTREAM:-$WEB_BIND_IP:$PORT}"
      printf 'SWARTZIT_STATE_DIR=%q\n' "$STATE_DIR"
    } > "$STATE_DIR/runtime.env"
    [[ -x "$SERVER" ]] || { echo "Missing Swartzit server: $SERVER" >&2; exit 1; }
    [[ -f "$WEB_BUILD/index.js" ]] || { echo "Missing web build: $WEB_BUILD/index.js" >&2; exit 1; }
    start_service_processes
    echo "Swartzit started: $HOST:$PORT ($NETWORK_LABEL; $WEB_INTERFACE)"
    echo "Web URL: http://$HOST:$PORT"
    echo "API bind: $BIND_ADDR ($API_INTERFACE)"
    refresh_caddy
    ;;
  restart)
    shift
    NETWORK_REQUESTED="${1:-${SWARTZIT_MODE:-${SWARTZIT_BIND_INTERFACE:-}}}"
    NETWORK_ARGUMENT_SET=0
    [[ -n "$NETWORK_REQUESTED" ]] && NETWORK_ARGUMENT_SET=1
    CADDY_OVERRIDE_SET=0
    DOMAIN_OVERRIDE_SET=0
    CADDY_BIND_OVERRIDE_SET=0
    CADDY_UPSTREAM_OVERRIDE_SET=0
    if [[ -n "${SWARTZIT_CADDY+x}" ]]; then CADDY_OVERRIDE_SET=1; CADDY_OVERRIDE="$SWARTZIT_CADDY"; fi
    if [[ -n "${SWARTZIT_DOMAIN+x}" ]]; then DOMAIN_OVERRIDE_SET=1; DOMAIN_OVERRIDE="$SWARTZIT_DOMAIN"; fi
    if [[ -n "${SWARTZIT_CADDY_BIND_IP+x}" ]]; then CADDY_BIND_OVERRIDE_SET=1; CADDY_BIND_OVERRIDE="$SWARTZIT_CADDY_BIND_IP"; fi
    if [[ -n "${SWARTZIT_CADDY_UPSTREAM+x}" ]]; then CADDY_UPSTREAM_OVERRIDE_SET=1; CADDY_UPSTREAM_OVERRIDE="$SWARTZIT_CADDY_UPSTREAM"; fi
    if [[ -f "$STATE_DIR/runtime.env" ]]; then
      set -a
      source "$STATE_DIR/runtime.env"
      set +a
      if (( ! NETWORK_ARGUMENT_SET )); then
        # Reuse the exact interface selected for the running service. This is
        # important when en0 fell back to en1, or when a deployment uses a
        # specific VPN/bridge interface rather than the default Wi-Fi mode.
        if [[ "${SWARTZIT_WEB_INTERFACE:-}" =~ ^(en[0-9]+|utun[0-9]+|bridge[0-9]+|lo0|loopback)$ ]]; then
          NETWORK_REQUESTED="$SWARTZIT_WEB_INTERFACE"
        else
          NETWORK_REQUESTED="${SWARTZIT_NETWORK_MODE:-}"
        fi
      fi
      if [[ -n "${SWARTZIT_API_BIND_INTERFACE:-}" ]]; then
        SWARTZIT_API_INTERFACE="$SWARTZIT_API_BIND_INTERFACE"
      fi
      unset API_URL BIND_ADDR HOST ORIGIN SWARTZIT_LOCAL_URL \
        SWARTZIT_NETWORK_MODE SWARTZIT_NETWORK_LABEL SWARTZIT_WEB_INTERFACE \
        SWARTZIT_WEB_BIND_IP SWARTZIT_API_BIND_INTERFACE SWARTZIT_API_BIND_IP \
        SWARTZIT_STARTED_AT SWARTZIT_CADDY_BIND_IP SWARTZIT_CADDY_UPSTREAM
    fi
    if [[ -z "$NETWORK_REQUESTED" ]]; then
      NETWORK_REQUESTED="${SWARTZIT_MODE:-${SWARTZIT_BIND_INTERFACE:-wifi}}"
    fi
    if (( CADDY_OVERRIDE_SET )); then SWARTZIT_CADDY="$CADDY_OVERRIDE"; fi
    if (( DOMAIN_OVERRIDE_SET )); then SWARTZIT_DOMAIN="$DOMAIN_OVERRIDE"; fi
    if (( CADDY_BIND_OVERRIDE_SET )); then SWARTZIT_CADDY_BIND_IP="$CADDY_BIND_OVERRIDE"; fi
    if (( CADDY_UPSTREAM_OVERRIDE_SET )); then SWARTZIT_CADDY_UPSTREAM="$CADDY_UPSTREAM_OVERRIDE"; fi
    if (( ! CADDY_OVERRIDE_SET )) && caddy_configured; then SWARTZIT_CADDY=1; fi
    "$0" stop >/dev/null
    exec "$0" start "$NETWORK_REQUESTED"
    ;;
  stop)
    stop_service_processes
    echo 'Swartzit stopped; database data was preserved.'
    ;;
  status)
    STATUS_SCRIPT="$HOME_DIR/scripts/status-local.sh"
    [[ -x "$STATUS_SCRIPT" ]] || STATUS_SCRIPT="$HOME_DIR/libexec/status-local.sh"
    if [[ -x "$STATUS_SCRIPT" ]]; then shift; exec "$STATUS_SCRIPT" "$@"; fi
    if curl -fsS --max-time 3 "${API_URL:-http://127.0.0.1:18080}/ready" >/dev/null; then echo 'API: ready'; else echo 'API: down'; fi
    ;;
  interfaces|network-options) shift; exec "$SCRIPT_HOME/network-options.sh" "$@" ;;
  caddy) shift; exec "$SCRIPT_HOME/swartzit-caddy.sh" "${1:-status}" ;;
  caddy-install) shift; exec "$SCRIPT_HOME/install-mac-caddy.sh" "$@" ;;
  backup) exec "$SCRIPT_HOME/db-backup.sh" ;;
  backup-install) shift; exec "$SCRIPT_HOME/install-mac-backup.sh" "$@" ;;
  restore-verify) shift; exec "$SCRIPT_HOME/db-restore-verify.sh" "$@" ;;
  rollback) shift; exec "$SCRIPT_HOME/db-restore.sh" "$@" ;;
  update) shift; exec "$SCRIPT_HOME/swartzit-update.sh" "$@" ;;
  monitor) shift; exec "$SCRIPT_HOME/swartzit-monitor.sh" "$@" ;;
  monitor-install) shift; exec "$SCRIPT_HOME/install-mac-monitor.sh" "$@" ;;
  status-install) shift; exec "$SCRIPT_HOME/install-mac-status.sh" "$@" ;;
  orchard) shift; exec "$SCRIPT_HOME/swartzit-orchard.sh" "$@" ;;
  *) echo 'Usage: swartzit {version|start|restart|stop|status|interfaces|caddy|caddy-install|status-install|backup|backup-install|restore-verify|rollback|update|monitor|monitor-install|orchard}' >&2; exit 2 ;;
esac

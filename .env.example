# PostgreSQL connection used by swartzit-server
DATABASE_URL=postgres://swartzit:change-me@127.0.0.1:5432/swartzit

# Keep loopback when fronted by Caddy or Tor
BIND_ADDR=127.0.0.1:8080

# Server-side API origin for the SvelteKit Node deployment
API_URL=http://127.0.0.1:18080

# macOS launcher controls. Use loopback, wifi, ethernet, vpn, public, or en0/en1.
SWARTZIT_BIND_INTERFACE=wifi
SWARTZIT_API_INTERFACE=loopback
SWARTZIT_ORIGIN=https://stoverparc.org

# Optional external liveness monitor (defaults to the public origin above).
SWARTZIT_CHECK_URL=https://stoverparc.org/
SWARTZIT_CHECK_INTERVAL=300
SWARTZIT_CHECK_TIMEOUT=10

# Security activity. Keep the API loopback-only behind Caddy; the web proxy
# forwards the trusted client address and the API stores only a keyed hash.
TRUST_PROXY=false
IP_HASH_SECRET=replace-with-a-long-random-secret
SWARTZIT_IP_ACTIVITY_SUCCESS=1

# Media storage: primary plus an optional asynchronous secondary replica.
SWARTZIT_MEDIA_PRIMARY=filesystem
SWARTZIT_MEDIA_SECONDARY=disabled
SWARTZIT_MEDIA_ROOT=/var/lib/swartzit/media
SWARTZIT_MEDIA_CACHE_DIR=/var/cache/swartzit/media
SWARTZIT_MEDIA_CACHE_MAX_BYTES=5368709120
SWARTZIT_MEDIA_SHARE=disabled

# IPFS/Kubo RPC is local-only by default; never expose the RPC port publicly.
SWARTZIT_IPFS_API_URL=http://127.0.0.1:5001
# SWARTZIT_IPFS_GATEWAY_URL=https://ipfs.example.net
# SWARTZIT_IPFS_API_TOKEN=

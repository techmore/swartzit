# /etc/swartzit/bible-feed.env (mode 0600, owner swartzit)
# An admin account used only for scheduled imports.
SCHEDULER_HANDLE=reader
SCHEDULER_PASSWORD=change-me
# The private API address (not the public web origin).
API_URL=http://127.0.0.1:18080
# This instance's public https address; daily-reading and catechism posts link here.
SWARTZIT_ORIGIN=https://example.org

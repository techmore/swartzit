[Unit]
Description=Swartzit discussion server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=swartzit
Group=swartzit
WorkingDirectory=/var/lib/swartzit
EnvironmentFile=/etc/swartzit/server.env
ExecStart=/usr/local/bin/swartzit-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/swartzit

[Install]
WantedBy=multi-user.target

[Unit]
Description=Update Swartzit from GitHub with backup and health gates
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/swartzit/.git

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/lib/swartzit
EnvironmentFile=-/etc/swartzit/update.env
# Verify a pinned release; apply only with SWARTZIT_AUTO_UPDATE=true.
Environment=SWARTZIT_APP_DIR=/var/lib/swartzit
ExecStart=/usr/local/libexec/swartzit/scripts/swartzit-upgrade-check.sh
Nice=10
IOSchedulingClass=best-effort

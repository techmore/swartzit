[Unit]
Description=Swartzit safe release check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/lib/swartzit
EnvironmentFile=-/etc/swartzit/upgrade.env
Environment=SWARTZIT_APP_DIR=/var/lib/swartzit
ExecStart=/usr/local/libexec/swartzit/scripts/swartzit-upgrade-check.sh
